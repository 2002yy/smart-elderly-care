<!--pages/service_detail/service_detail.wxml-->
<view class="detail-container">
  <view class="detail-card">
    <!-- 服务类型 -->
    <view class="detail-item">
      <view class="detail-label">服务类型</view>
      <view class="detail-value">
        <block wx:if="{{serviceData.typeText}}">{{serviceData.typeText}}</block>
        <block wx:else>
          <block wx:if="{{serviceData.type === 0}}">生活照料</block>
          <block wx:elif="{{serviceData.type === 1}}">医疗护理</block>
          <block wx:elif="{{serviceData.type === 2}}">心理护理</block>
          <block wx:else>未知类型</block>
        </block>
      </view>
    </view>

    <!-- 服务对象 -->
    <view class="detail-item">
      <view class="detail-label">服务对象</view>
      <view class="detail-value">{{serviceData.targetName || '未指定'}}</view>
    </view>

    <!-- 预约时间 -->
    <view class="detail-item">
      <view class="detail-label">预约时间</view>
      <view class="detail-value">{{serviceData.scheduledTime}}</view>
    </view>

    <!-- 服务地址 -->
    <view class="detail-item">
      <view class="detail-label">服务地址</view>
      <view class="detail-value">{{serviceData.address}}</view>
    </view>

    <!-- 服务备注 -->
    <view class="detail-item">
      <view class="detail-label">服务备注</view>
      <view class="detail-value remark">{{serviceData.remark || '无'}}</view>
    </view>

    <!-- 创建人 -->
    <view class="detail-item">
      <view class="detail-label">创建人</view>
      <view class="detail-value">{{serviceData.creator}}</view>
    </view>

    <!-- 创建时间 -->
    <view class="detail-item">
      <view class="detail-label">创建时间</view>
      <view class="detail-value">{{serviceData.createTime}}</view>
    </view>

    <!-- 服务状态 -->
    <view class="detail-item">
      <view class="detail-label">服务状态</view>
      <view class="detail-value status status-{{serviceData.status}}">{{serviceData.statusText}}</view>
    </view>

    <!-- 服务人员 -->
    <view class="detail-item">
      <view class="detail-label">服务人员</view>
      <view class="detail-value">{{serviceData.staff}}</view>
    </view>
  </view>

  <view wx:if="{{showApplicantsBtn}}" class="application-panel">
    <view class="application-warning">申请者是自行登记的服务人员，平台尚未核验资质。批准后将向其开放服务地址与老人信息。</view>
    <button class="action-btn" bindtap="loadApplications">查看接单申请</button>
    <view wx:if="{{applicationsLoaded && applications.length === 0}}" class="application-empty">尚无人申请</view>
    <view wx:for="{{applications}}" wx:key="applicationId" class="application-row">
      <text>{{item.name}} · {{item.status === 0 ? '待批准' : (item.status === 1 ? '已批准' : '未获批准')}}</text>
      <button wx:if="{{item.status === 0}}" size="mini" bindtap="approveApplication" data-id="{{item.applicationId}}" disabled="{{approvingApplication}}">批准</button>
    </view>
  </view>

  <!-- 底部按钮区域 -->
  <view class="button-area">
    <button wx:if="{{showStartBtn}}" class="action-btn" bindtap="onStartService" disabled="{{isLoading}}">声明开始服务</button>
    <button wx:if="{{showRequestCompletionBtn}}" class="action-btn" bindtap="onRequestCompletion" disabled="{{isLoading}}">提交完工声明</button>
    <view wx:if="{{awaitingCustomerConfirmation}}" class="application-warning">已提交完工声明，等待订单当事人确认。尚无到场或服务记录证据。</view>
    <button wx:if="{{showConfirmCompletionBtn}}" class="action-btn" bindtap="onConfirmCompletion" disabled="{{isLoading}}">确认已收到服务</button>
    <!-- 修改服务按钮 - 老人/监护人 & 待进行状态 -->
    <button 
      wx:if="{{showModifyBtn}}" 
      class="action-btn modify-btn" 
      bindtap="onModifyService"
      disabled="{{isLoading}}">
      修改服务
    </button>
    
    <!-- 未接入支付渠道：保留限制说明入口，不执行模拟支付 -->
    <button 
      wx:if="{{showPayBtn}}" 
      class="action-btn pay-btn" 
      bindtap="onPayment"
      disabled="{{isLoading}}">
      支付未开通
    </button>
    
    <!-- 评价按钮 - 老人/监护人 & 待评价状态 -->
    <button 
      wx:if="{{showEvaluateBtn}}" 
      class="action-btn evaluate-btn" 
      bindtap="onEvaluateService"
      disabled="{{isLoading}}">
      评价服务
    </button>
    
    <!-- 未实现服务端文件上传：仅展示限制说明 -->
    <button 
      wx:if="{{showUploadBtn}}" 
      class="action-btn upload-btn" 
      bindtap="onUploadRecord"
      disabled="{{isLoading}}">
      记录上传未开通
    </button>

    <!-- 删除服务按钮 (原取消按钮) -->
    <button class="action-btn cancel-btn" wx:if="{{(userType === 0 || userType === 1) && (serviceData.status === 0 || serviceData.status === 1)}}" bindtap="onCancelService">
      删除服务
    </button>
  </view>
</view>
