# 本地 Docker Compose 默认值。复制为 .env 后可按需覆盖；请勿提交真实密钥。
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=MiniApp
BACKEND_PORT=8081

# 本地占位值只保证服务能够启动；真实微信登录必须替换为公众平台配置。
WECHAT_APPID=local-placeholder-appid
WECHAT_APPSECRET=local-placeholder-appsecret

# 至少 32 字符。生产环境必须使用独立随机值。
JWT_SECRET=change-this-local-jwt-secret-32chars
